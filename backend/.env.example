# ---- App ----
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated list of origins allowed to call this API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://caption_user:caption_pass@localhost:5432/caption_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Local Compose uses Celery. Set JOB_BACKEND=modal to dispatch from a local
# API to the deployed Modal workers (requires Modal credentials and a shared DB).
JOB_BACKEND=celery
MODAL_APP_NAME=video-caption-app
CHUNK_STORAGE_BACKEND=local

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CONCURRENCY=2
GEMINI_CHUNK_SECONDS=600
GEMINI_CHUNK_OVERLAP_SECONDS=5

# ---- Local Compose storage (S3-compatible: AWS S3, Cloudflare R2, Supabase) ----
STORAGE_PROVIDER=s3
STORAGE_BUCKET=caption-app-storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=

# Modal deployments override STORAGE_PROVIDER and mount this Modal Volume.
MODAL_STORAGE_VOLUME=caption-app-media
MODAL_STORAGE_PATH=/mnt/modal-storage

# ---- Video limits ----
MAX_VIDEO_DURATION_SECONDS=3600
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm

# ---- Composite H.264 encoding ----
# Software (libx264) only. Thread values must be 1-16; CRF must be 0-51.
# FFMPEG_THREADS=4
# Defaults to FFMPEG_THREADS when omitted
# FFMPEG_FILTER_THREADS=4
# Standard quality uses this CRF; high quality keeps its profile unless set.
# H264_CRF=23
# Default cap applies through 720p/30 fps; larger frames scale up to 8x.
# Explicit rate and buffer settings are used as written.
# H264_MAXRATE=2500k
# H264_BUFSIZE=5000k
# NVENC uses separate CQ and source-aware VBR limits.
# NVENC_CQ=28
# H264_MIN_MAXRATE=1200k
# NVENC_MAXRATE_CAP=2500k

# ---- Caption overlay capture ----
# legacy captures every frame; adaptive reuses unchanged static frames.
CAPTION_RENDER_STRATEGY=legacy
# Chromium capture workers; tune for available CPU and memory (for example 4, 6, or 8).
RENDER_CAPTURE_WORKERS=4

# ---- Temp files / cleanup ----
TEMP_STORAGE_DIR=/tmp/caption_app
TEMP_FILE_RETENTION_MINUTES=60
CLEANUP_INTERVAL_MINUTES=15

# ---- Rate limiting ----
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
