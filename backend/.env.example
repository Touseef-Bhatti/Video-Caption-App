# ---- App ----
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated list of origins allowed to call this API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://caption_user:caption_pass@localhost:5432/caption_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_CHUNK_SECONDS=600
GEMINI_CHUNK_OVERLAP_SECONDS=5

# ---- Storage (S3-compatible: AWS S3, Cloudflare R2, Supabase) ----
STORAGE_PROVIDER=s3
STORAGE_BUCKET=caption-app-storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=

# ---- Video limits ----
MAX_VIDEO_DURATION_SECONDS=3600
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm

# ---- Temp files / cleanup ----
TEMP_STORAGE_DIR=/tmp/caption_app
TEMP_FILE_RETENTION_MINUTES=60
CLEANUP_INTERVAL_MINUTES=15

# ---- Rate limiting ----
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
