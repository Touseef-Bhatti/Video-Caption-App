# The backend base URL this Flutter client talks to.
# Passed at build/run time via --dart-define=API_BASE_URL=... (see
# lib/core/api_client.dart), NOT bundled as an asset -- so this file is
# documentation for that value, not something the app reads directly.
#
# Examples:
#   flutter run --dart-define=API_BASE_URL=http://localhost:8000
#   flutter build web --dart-define=API_BASE_URL=https://api.yourdomain.com
API_BASE_URL=http://localhost:8000
